# Sidecar binaries — fetched on first run with pinned versions + checksums.
# ffmpeg, HandBrakeCLI, yt-dlp, gallery-dl. ~140MB, deliberately not in git.
tools/

# Machine-local config, including the path to this machine's library root.
# Never committed — the whole point is that it differs per machine.
gallery.config.json

# Personal Claude Code overrides and runtime state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Build output
node_modules/
dist/
target/
*.log

# Generated by tauri-build from capabilities/ on every build
src-tauri/gen/

# WebView2's profile, redirected next to the executable
webview2/

# Throwaway M0 spike — results preserved at docs/M0-RESULTS.md
spike/

Thumbs.db
desktop.ini
